[Unit]
Description=Kekkai first-party TUN packet adapter
After=network-online.target kekkai-node.service
Requires=kekkai-node.service

[Service]
Type=simple
ExecStart=/usr/libexec/kekkai-tun-host --name kekkai0 --bridge /run/kekkai/packet.sock
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/dev/net/tun /run/kekkai
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
Restart=on-failure

[Install]
WantedBy=multi-user.target
