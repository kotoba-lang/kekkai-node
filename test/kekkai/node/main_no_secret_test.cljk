(ns kekkai.node.main-no-secret-test
  "`kbb -m kekkai.node.X` PRINTS the value -main resolves to. Every long-running
  entry point resolves to a handle whose state carries the node's Noise PRIVATE
  static key, so an entry point that returns the handle writes that key to
  stdout — and, under systemd, to the journal. Found deploying the gad funnel
  (2026-09-29): the key was printed on the first start and had to be rotated.

  The check is on the source, because running -main means binding real sockets:
  each -main must end its promise chain in `(.then (fn [_] nil))` or resolve to
  something other than the handle (agent's resolves to its status interval)."
  (:require [kotoba.test :refer [deftest is]]
            ["node:fs" :as fs]))

(def entry-points
  ["src/kekkai/node/funnel.cljk" "src/kekkai/node/access_edge.cljk"
   "src/kekkai/node/packet_bridge.cljk" "src/kekkai/node/stream_edge.cljk"])

(deftest no-entry-point-resolves-to-its-handle
  (doseq [p entry-points]
    (let [src (.readFileSync fs p "utf8")
          main (subs src (.indexOf src "(defn -main"))]
      (is (re-find #"\(\.then \(fn \[_\] nil\)\)" main)
          (str p ": -main must resolve to nil, not to the handle holding the private key")))))
