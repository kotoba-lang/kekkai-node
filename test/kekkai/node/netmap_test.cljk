(ns kekkai.node.netmap-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kekkai.node.netmap :as netmap]))

(def nm
  {:netmap/version 42
   :netmap/tailnet "kekkai.example"
   :netmap/self {:node/id "asher" :node/key "aa" :node/overlay-ip "100.64.0.1"}
   :netmap/peers
   [{:node/id "judah" :node/key "bb" :node/overlay-ip "100.64.0.2"
     :node/status "authorized" :node/expires-at 2000
     :node/endpoints [{:kind :reflexive :host "203.0.113.9" :port 41641}]}
    {:node/id "zebulun" :node/key "cc" :node/overlay-ip "100.64.0.3"
     :node/status "authorized" :node/expires-at 2000}
    {:node/id "eve" :node/key "dd" :node/overlay-ip "100.64.0.4"
     :node/status "pending"}
    {:node/id "stale" :node/key "ee" :node/overlay-ip "100.64.0.5"
     :node/status "authorized" :node/expires-at 500}]
   :netmap/edges
   [{:edge/from "asher" :edge/to "judah"
     :edge/capabilities [:overlay :ssh :private-http]
     :edge/ports [22 443]}
    {:edge/from "asher" :edge/to "zebulun" :edge/capabilities [:overlay]}
    {:edge/from "asher" :edge/to "eve" :edge/capabilities [:overlay]}
    {:edge/from "asher" :edge/to "stale" :edge/capabilities [:overlay]}]
   :netmap/relays [{:relay/name "jp-tyo-1" :relay/region "jp"
                    :relay/host "relay.example" :relay/port 41642 :relay/key "ff"}]})

(deftest validation
  (is (netmap/usable? nm))
  (is (not (netmap/usable? (dissoc nm :netmap/version))))
  (is (not (netmap/usable? (dissoc nm :netmap/tailnet))))
  (testing "a peer without a key is a problem, not a peer to be skipped silently"
    (is (= [{:problem :peer-missing-key :peer "judah"}]
           (netmap/validate (assoc-in nm [:netmap/peers 0 :node/key] ""))))))

(deftest deny-by-default
  (testing "no edge means denied even for an authorized peer"
    (is (not (netmap/reachable? nm "asher" "judah" :sql)))
    (is (netmap/reachable? nm "asher" "judah" :ssh))
    (is (not (netmap/reachable? nm "asher" "unknown-node" :overlay))))
  (testing "edges are directional"
    (is (not (netmap/reachable? nm "judah" "asher" :overlay)))))

(deftest admission-and-expiry
  (is (netmap/authorized? (first (:netmap/peers nm)) 1000))
  (testing "a pending peer is not admitted"
    (is (not (netmap/authorized? (nth (:netmap/peers nm) 2) 1000))))
  (testing "an authorized peer with an expired key is not admitted — being in the
            netmap is never, on its own, sufficient"
    (is (not (netmap/authorized? (nth (:netmap/peers nm) 3) 1000)))))

(deftest dialable-folds-admission-and-edges
  (let [ids (mapv (comp :node/id :peer) (netmap/dialable nm :overlay 1000))]
    (is (= ["judah" "zebulun"] ids))
    (testing "the ssh capability is granted to judah only"
      (is (= ["judah"] (mapv (comp :node/id :peer) (netmap/dialable nm :ssh 1000)))))))

(deftest application-permission-is-direction-and-port-aware
  (is (netmap/permitted? nm "asher" "judah" :private-http 443))
  (is (not (netmap/permitted? nm "asher" "judah" :private-http 80)))
  (is (not (netmap/permitted? nm "judah" "asher" :private-http 443))))

(deftest inbound-only-edges-still-create-an-authenticated-session
  (let [inbound (-> nm
                    (assoc :netmap/peers
                           [{:node/id "judah" :node/key "bb"
                             :node/status "authorized" :node/expires-at 2000}])
                    (assoc :netmap/edges
                           [{:edge/from "judah" :edge/to "asher"
                             :edge/capabilities [:overlay :private-http]
                             :edge/ports [443]}]))
        peer (first (netmap/sessionable inbound 1000))]
    (is (= "judah" (get-in peer [:peer :node/id])))
    (is (= #{} (:outgoing-capabilities peer)))
    (is (= #{:overlay :private-http} (:incoming-capabilities peer)))
    (is (empty? (netmap/dialable inbound :overlay 1000)))))

(deftest denials-are-explainable
  (let [by-peer (into {} (map (juxt :peer :denied)) (netmap/denials nm :overlay 1000))]
    (is (= :status-pending (get by-peer "eve")))
    (is (= :key-expired (get by-peer "stale")))
    (is (nil? (get by-peer "judah"))))
  (testing "admission is reported before the edge grant: a pending or expired peer
            is denied for being un-admitted, not for lacking the capability —
            fixing the edge would not have helped"
    (let [by-peer (into {} (map (juxt :peer :denied)) (netmap/denials nm :sql 1000))]
      (is (= {"judah" :no-edge-grant "zebulun" :no-edge-grant
              "eve" :status-pending "stale" :key-expired}
             by-peer))
      (testing "and the denial says what *was* granted, so the fix is obvious"
        (is (= #{:ssh :overlay :private-http}
               (:granted (first (filter #(= "judah" (:peer %))
                                        (netmap/denials nm :sql 1000))))))))))

(deftest prologue-binds-tailnet-and-version
  (is (= "kekkai-node/1 tailnet:kekkai.example netmap:42" (netmap/prologue-string nm)))
  (testing "a different netmap version yields a different prologue, which is what
            makes a stale peer fail the handshake instead of using stale ACLs"
    (is (not= (netmap/prologue-string nm)
              (netmap/prologue-string (assoc nm :netmap/version 43))))))

;; ── funnel ──────────────────────────────────────────────────────────────────

(defn- funnel-nm
  "The shape the control plane publishes: the funnel record, and its grant as a
  SEPARATE edge entry after any ACL entry for the same pair."
  [self]
  {:netmap/version 7
   :netmap/tailnet "kekkai.example"
   :netmap/self {:node/id self :node/key "aa"}
   :netmap/peers
   [{:node/id (if (= self "edge-1") "gad" "edge-1") :node/key "bb"
     :node/status "authorized" :node/expires-at 2000}]
   :netmap/edges
   [{:edge/from "edge-1" :edge/to "gad"
     :edge/capabilities [:overlay :ssh] :edge/ports [22]}
    {:edge/from "edge-1" :edge/to "gad"
     :edge/capabilities [:funnel] :edge/ports [8080]}]
   :netmap/funnels
   [{:funnel/host "blocks.example.net" :funnel/edge "edge-1"
     :funnel/node "gad" :funnel/service "block-node" :funnel/port 8080}]})

(deftest funnel-host-normalization
  (is (= "blocks.example.net" (netmap/normalize-host "blocks.example.net")))
  (testing "case, one trailing dot and a port are not part of the name"
    (is (= "blocks.example.net" (netmap/normalize-host "Blocks.Example.NET.")))
    (is (= "blocks.example.net" (netmap/normalize-host "blocks.example.net:443")))
    (is (= "blocks.example.net" (netmap/normalize-host "BLOCKS.example.net.:8443"))))
  (testing "anything that is not a plain DNS name is nil, never a guess"
    (doseq [bad [nil "" "   " 42 "[::1]" "[::1]:443" "a:b:1" "blocks.example.net:"
                 "a..b" "-a.b" "a-.b" "a_b.example" "blocks example.net"
                 "blocks.example.net/x" (apply str (repeat 254 "a"))]]
      (is (nil? (netmap/normalize-host bad)) (pr-str bad)))))

(deftest funnel-for-host-is-edge-local-and-grant-gated
  (let [nm (funnel-nm "edge-1")]
    (is (= "gad" (:funnel/node (netmap/funnel-for-host nm "blocks.example.net"))))
    (is (= "gad" (:funnel/node (netmap/funnel-for-host nm "BLOCKS.example.net:443"))))
    (is (nil? (netmap/funnel-for-host nm "other.example.net")))
    (is (nil? (netmap/funnel-for-host nm "[::1]")))
    (testing "a funnel whose edge is another node is not this node's to serve"
      (is (nil? (netmap/funnel-for-host (funnel-nm "gad") "blocks.example.net")))
      (is (nil? (netmap/funnel-for-host
                 (assoc-in nm [:netmap/funnels 0 :funnel/edge] "edge-2")
                 "blocks.example.net"))))
    (testing "the listing without the :funnel edge grant is not a route"
      (is (nil? (netmap/funnel-for-host
                 (update nm :netmap/edges (partial into [] (take 1)))
                 "blocks.example.net"))))))

(deftest funnel-admits-needs-listing-and-grant
  (let [nm (funnel-nm "gad")]
    (is (netmap/funnel-admits? nm "edge-1" "gad" 8080 "block-node"))
    (testing "every field of the listing must match"
      (is (not (netmap/funnel-admits? nm "edge-2" "gad" 8080 "block-node")))
      (is (not (netmap/funnel-admits? nm "edge-1" "judah" 8080 "block-node")))
      (is (not (netmap/funnel-admits? nm "edge-1" "gad" 8081 "block-node")))
      (is (not (netmap/funnel-admits? nm "edge-1" "gad" 8080 "other"))))
    (testing "the listing alone is not authority"
      (is (not (netmap/funnel-admits?
                (update nm :netmap/edges (partial into [] (take 1)))
                "edge-1" "gad" 8080 "block-node"))))
    (testing "a :private-http grant never admits public funnel traffic"
      (is (not (netmap/funnel-admits?
                (assoc nm :netmap/edges
                       [{:edge/from "edge-1" :edge/to "gad"
                         :edge/capabilities [:overlay :private-http]
                         :edge/ports [8080]}])
                "edge-1" "gad" 8080 "block-node"))))
    (testing "and a :funnel grant never admits :private-http, :ssh or :overlay use"
      (is (not (netmap/permitted? nm "edge-1" "gad" :private-http 8080)))
      (is (not (netmap/permitted? nm "edge-1" "gad" :ssh 8080))))
    (testing "two entries for one pair: ports do not cross between them"
      (is (netmap/permitted? nm "edge-1" "gad" :ssh 22))
      (is (netmap/permitted? nm "edge-1" "gad" :funnel 8080))
      (is (not (netmap/permitted? nm "edge-1" "gad" :ssh 8080)))
      (is (not (netmap/permitted? nm "edge-1" "gad" :funnel 22))))
    (testing "the grant is directional"
      (is (not (netmap/funnel-admits?
                (assoc nm :netmap/edges
                       [{:edge/from "gad" :edge/to "edge-1"
                         :edge/capabilities [:funnel] :edge/ports [8080]}])
                "edge-1" "gad" 8080 "block-node"))))))

(deftest funnel-only-edge-still-opens-a-session
  (let [only-funnel (fn [self]
                      (update (funnel-nm self) :netmap/edges
                              (partial into [] (drop 1))))]
    (testing "both ends of a [:funnel]-only edge hold a session"
      (is (= ["gad"] (mapv (comp :node/id :peer)
                           (netmap/sessionable (only-funnel "edge-1") 1000))))
      (is (= ["edge-1"] (mapv (comp :node/id :peer)
                              (netmap/sessionable (only-funnel "gad") 1000)))))
    (testing "and that session is not overlay authority"
      (is (empty? (netmap/dialable (only-funnel "edge-1") :overlay 1000)))
      (is (not (netmap/reachable? (only-funnel "edge-1") "edge-1" "gad" :overlay))))
    (testing "an expired peer gets no session and is not admitted"
      (is (empty? (netmap/sessionable (only-funnel "edge-1") 3000)))
      (is (netmap/peer-admitted? (only-funnel "edge-1") "gad" 1000))
      (is (not (netmap/peer-admitted? (only-funnel "edge-1") "gad" 3000)))
      (is (not (netmap/peer-admitted? (only-funnel "edge-1") "nobody" 1000))))))

(deftest funnel-validation
  (let [nm (funnel-nm "edge-1")
        f (first (:netmap/funnels nm))
        problems (fn [funnels] (mapv :problem (netmap/validate
                                               (assoc nm :netmap/funnels funnels))))]
    (is (netmap/usable? nm))
    (is (netmap/usable? (dissoc nm :netmap/funnels)) "no funnels is fine")
    (is (netmap/usable? (assoc nm :netmap/funnels [])))
    (is (= [:funnels-not-sequential] (problems {:a 1})))
    (is (= [:funnel-duplicate-host]
           (problems [f (assoc f :funnel/node "judah")])))
    (testing "hosts must already be in the canonical form lookups use"
      (is (= [:funnel-bad-host] (problems [(assoc f :funnel/host "Blocks.example.net")])))
      (is (= [:funnel-bad-host] (problems [(assoc f :funnel/host "blocks.example.net.")])))
      (is (= [:funnel-bad-host] (problems [(assoc f :funnel/host "blocks.example.net:443")]))))
    (is (= [:funnel-missing-edge] (problems [(dissoc f :funnel/edge)])))
    (is (= [:funnel-missing-node] (problems [(assoc f :funnel/node "")])))
    (is (= [:funnel-missing-service] (problems [(dissoc f :funnel/service)])))
    (is (= [:funnel-bad-port] (problems [(assoc f :funnel/port "8080")])))
    (is (= [:funnel-bad-port] (problems [(assoc f :funnel/port 0)])))
    (is (= [:funnel-not-a-map] (problems ["blocks.example.net"])))))
